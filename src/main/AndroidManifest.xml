<manifest package="ru.evotor.integrations"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="evo.v2.receipt.paymentSystem"/>
        </intent>
        <intent>
            <action android:name="evo.v2.receipt.sell.payment.COMBINED"/>
