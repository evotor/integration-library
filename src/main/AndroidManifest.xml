        </intent>
        <intent>
            <action android:name="evo.v2.receipt.correction.return.income.printReceipt"/>
        </intent>
        <intent>
            <action android:name="evo.v2.receipt.correction.return.outcome.printReceipt"/>
        </intent>
        <intent>
            <action android:name="evo.v2.unprinted_document.print"/>
        </intent>
        <intent>
            <action android:name="evo.v2.zreport.print"/>
        </intent>
    </queries>

</manifest>
